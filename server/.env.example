PORT=3001
HOST=127.0.0.1
# Local development may leave this empty and use .data/rooms.json.
# Vercel MUST use a native Redis TCP/TLS URL with PUB/SUB support (not a REST endpoint).
REDIS_URL=
REDIS_NAMESPACE=connection:development
# Same-domain WebSockets are allowed automatically; list additional trusted frontend origins only.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Local single-process persistence only.
ROOM_DATA_FILE=.data/rooms.json
